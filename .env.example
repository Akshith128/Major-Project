# Reasoning model for the agents: ollama (local, free, no quota), groq or gemini.
AEGIS_LLM_PROVIDER=ollama
# Ollama: install from https://ollama.com, then `ollama pull qwen2.5:3b`.
# AEGIS_OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_URL=http://127.0.0.1:11434

# Groq (hosted free tier, rate limited): https://console.groq.com
# GROQ_API_KEY=
# AEGIS_GROQ_MODEL=llama-3.1-8b-instant

# Gemini. Never commit a real key.
# GOOGLE_API_KEY=

# Optional: keys for signing audit records and login sessions. If unset, AEGIS
# generates them once in ~/.aegis (outside the project and the run files).
# AEGIS_AUDIT_KEY=
# AEGIS_AUTH_SECRET=
